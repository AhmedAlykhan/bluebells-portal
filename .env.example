# ==============================================================================
# BLUEBELLS SCHOOLING SYSTEM - ENVIRONMENT TEMPLATE
# ==============================================================================
# Security Notice: Never commit filled-in '.env' files or secrets to source control.
# Copy this file to '.env' and populate with cryptographically secure credentials.

# --- Database Configuration ---
DB_HOST=localhost
DB_PORT=3306
DB_NAME=bluebells_school_db
DB_USER=bluebells_user
DB_PASSWORD=replace_with_strong_db_password_min_16_chars
DB_ROOT_PASSWORD=replace_with_strong_root_password_min_16_chars
DATABASE_URL=jdbc:mysql://localhost:3306/bluebells_school_db?useSSL=true&allowPublicKeyRetrieval=true&serverTimezone=Asia/Karachi

# --- Application Server & Security ---
PORT=8080
SPRING_PROFILES_ACTIVE=prod
# Generate via: openssl rand -base64 64 (minimum 512 bits / 64 characters)
JWT_SECRET=replace_with_base64_jwt_secret_min_64_characters_long_for_hmac512

# --- Initial Bootstrap Administrator ---
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=replace_with_initial_strong_bootstrap_password
INITIAL_ADMIN_EMAIL=admin@bluebells.edu.pk

# --- Persistent File Storage ---
# For local container volume or persistent mount
STORAGE_DIR=/var/bluebells/storage

# --- CORS & Allowed Origins ---
# Comma-separated list of allowed frontend production origins
CORS_ALLOWED_ORIGINS=https://portal.bluebells.edu.pk,https://bluebells-portal.vercel.app

# --- Frontend Build Variables ---
# Exposed to client-side bundle at build time (Vite)
VITE_API_URL=https://api.bluebells.edu.pk
